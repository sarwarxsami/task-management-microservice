# Copy to .env (never commit .env). Used by docker-compose.yml for postgres and both services.
DB_HOST=postgres-db
DB_PORT=5432
DB_NAME=postgresdb
DB_USER=change-me
DB_PASSWORD=change-me

# Shared HS256 signing key for login tokens (at least 32 characters): openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Comma-separated student IDs that are given the admin role when they log in
ADMIN_STUDENT_IDS=
